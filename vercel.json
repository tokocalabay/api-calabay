{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/v1/(.*)", "dest": "/api/index.js" },
    { "src": "/docs", "dest": "/public/api-docs.html" },
    { "src": "/docs/(.*)", "dest": "/public/api-docs.html" },
    { "src": "/", "dest": "/public/api-docs.html" }
  ]
}
